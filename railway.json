{
  "project": "nexus-panel",
  "service": "nexus-web",
  "buildCommand": "pip install -r requirements.txt",
  "startCommand": "gunicorn main:app --bind 0.0.0.0:$PORT --workers 1 --timeout 120 --access-logfile - --error-logfile -",
  "healthCheckPath": "/login",
  "envVars": {
    "FLASK_SECRET": {
      "generator": "random"
    },
    "ADMIN_PASS": "5656",
    "DEBUG": "false",
    "API_CREATE_KEY": "Super"
  }
}
